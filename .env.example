# DiffSentinel — sample environment for deploy scripts.
# Copy this file to .env and fill in real values for local runs.
# The production .env is never committed.

# Funded Bradbury account used by deploy + seeding scripts.
# Hex private key (0x-prefixed or bare hex, 64 hex chars).
ACCOUNT_PRIVATE_KEY=

# Address receiving the fee share. Blank means the deployer address.
FEE_RECIPIENT=

# Fee taken from each verify_commit call, in basis points (100 = 1%).
# Default 100.
FEE_BPS=100

# Optional: override contract address for frontend/seed scripts if you
# want to reuse an existing deployment. Not required.
# VITE_CONTRACT_ADDRESS=0x...
